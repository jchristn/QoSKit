<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QoSKit\QoSKit.csproj" />
    <ProjectReference Include="..\QoSKit.Persistence.Sqlite\QoSKit.Persistence.Sqlite.csproj" />
    <!-- Force the crash harness to build alongside the tests without referencing its output; the
         crash-durability test locates and runs its exe at runtime. -->
    <ProjectReference Include="..\Test.CrashHarness\Test.CrashHarness.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Touchstone.Core" Version="0.1.12" />
  </ItemGroup>

</Project>
